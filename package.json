{
  "name": "website-analyzer-mcp",
  "version": "0.1.1",
  "description": "Turn any website into a reusable design system — free open-source MCP for Claude, Cursor, and other MCP clients",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "website-analyzer-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "website",
    "design-system",
    "playwright",
    "analyzer"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigy2012/website-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/bigy2012/website-analyzer/issues"
  },
  "homepage": "https://github.com/bigy2012/website-analyzer#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
